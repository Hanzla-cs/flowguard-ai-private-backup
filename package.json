{
  "name": "flowguard-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent FlowGuard analytical contracts and fixture test foundation; no metric engine.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run tests/foundation.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
